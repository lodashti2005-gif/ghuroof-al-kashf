{
  "expo": {
    "owner": "wara-al-salfa-team",
    "name": "ورا السالفة",
    "slug": "wara-al-salfa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "waralsalfa",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c0f",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b0c0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.waralsalfa.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ar",
        "NSMicrophoneUsageDescription": "يُستخدم الميكروفون لتسجيل أسئلتك الصوتية للمشتبه فيهم داخل ورا السالفة.",
        "NSSpeechRecognitionUsageDescription": "يُستخدم التعرف على الكلام لتحويل أسئلتك الصوتية إلى نص داخل استجواب ورا السالفة.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "ba44bdc5-142a-4f69-ba6d-2e83649a983d"
      },
      "gameUrl": "https://waralsalfa.com"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
