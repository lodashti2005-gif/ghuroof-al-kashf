# متغيرات البيئة المطلوبة — القيم الحقيقية تُحفظ في Project Settings → Secrets
# لا تضع أي مفتاح حقيقي في هذا الملف.

# ── Paddle (بوابة الدفع) ───────────────────────────────────────────────
# مفتاح API الحقيقي (Live). يبدأ بـ pdl_live_apikey_...
PADDLE_API_KEY=
# البيئة: live أو sandbox
PADDLE_ENV=live
# معرّف السعر من كتالوج Paddle الحقيقي (pri_...)
PADDLE_PRICE_ID=
# عملة الدفع
PADDLE_CURRENCY=USD
# بديل مؤقت للسعر بدون كتالوج (بالسنت) — اتركه فارغاً عند استخدام PADDLE_PRICE_ID
PADDLE_UNIT_AMOUNT_CENTS=
# رابط الرجوع بعد إتمام الدفع
PADDLE_RETURN_URL=https://ghuroof-al-kashf.lovable.app/cases
# سر التوقيع من notification destination الحقيقي (pdl_ntfset_... / endpoint_secret_key)
PADDLE_WEBHOOK_SECRET=
# رمز العميل للواجهة (Paddle.js) — يبدأ بـ live_ — يُستخدم فقط لو أضفنا Paddle.js لاحقاً
VITE_PADDLE_CLIENT_TOKEN=

# ── Lovable Cloud / قاعدة البيانات (تُدار تلقائياً) ─────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# كود خصم يُطبّق تلقائياً على العملية (للاختبار الحقيقي بصفر دينار)
PADDLE_DISCOUNT_CODE=
# معرّف الخصم مباشرة (بديل عن الكود)
PADDLE_DISCOUNT_ID=
# true = يرفض الخادم أي عملية مبلغها أكبر من صفر (وضع الاختبار)
PADDLE_REQUIRE_ZERO_TOTAL=
